#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# Leak guard for pushes: scans every commit being pushed (tools/leak-scan.py --range) and refuses on any hit,
# on a path under .claude/, or on a commit identity that is not a noreply address.
set -euo pipefail
top="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue          # branch deletion
    if [[ "$remote_sha" == "$zero" ]]; then
        # new branch: only the commits the remote does not have yet
        base="$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null || true)"
    else
        base="$remote_sha"
    fi
    if git diff --name-only --diff-filter=ACMRT "${base:-$(git hash-object -t tree /dev/null)}" "$local_sha" | grep -qE '^(\.claude/|CLAUDE\.local\.md$)'; then
        echo "pre-push: REFUSED: $remote_ref would publish a path under .claude/." >&2
        rc=1; continue
    fi
    python3 -I "$top/tools/leak-scan.py" --range "${base}..${local_sha}" || rc=1
done
[[ $rc -eq 0 ]] || echo "pre-push: REFUSED (nothing was pushed)" >&2
exit $rc
