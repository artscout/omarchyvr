# pimaxd: the Pimax stack's owner (docs/PIMAXD.md). User unit, started at login (user decision 2026-10-15).
# NOT installed or enabled by anything. Between sessions (no VR running), see analysis/pimaxd-live-checklist.md:
#   install -Dm644 packaging/systemd/pimaxd.service ~/.config/systemd/user/pimaxd.service
#   systemctl --user daemon-reload && systemctl --user enable --now pimaxd
# Observe only until ~/.config/pimax/pimaxd.toml says [restart] enabled = true (and ~/.config/pimax/safe-mode is
# absent). Replaces pimax-autod.service (same socket): do not run both. Stopping the unit never stops a VR session.
[Unit]
Description=Pimax Dream Air stack owner (auto mode + component reconciler)
After=graphical-session.target pimax-keepalived.service
PartOf=graphical-session.target
Conflicts=pimax-autod.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/pimax-re/rust/target/release/pimaxd run
# only the daemon itself: sessions and the leaves it respawned (setsid) survive a restart
KillMode=process
KillSignal=SIGTERM
Restart=on-failure
RestartSec=10
Nice=5

[Install]
WantedBy=graphical-session.target
