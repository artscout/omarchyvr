# Put-on: the headset lies on the desk, is picked up and put on. Desk mode starts once.
at 0 plugged=1 motion=still
expect 3 unplugged          # plug debounce (4 s)
expect 5 plugged
at 20 motion=moving         # picked up
at 22 motion=worn           # on the head (micro-motion)
expect 23 plugged           # wear_on_s = 4 s of continuous evidence
expect 25 worn              # start running (pimax desk start --6dof --ctrl-track ...)
expect 28 active(desk)
expect 300 active(desk)
