SUBSYSTEM=="hidraw", ATTRS{idVendor}=="34a4", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="34a4", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2104", ATTRS{idProduct}=="0561", MODE="0660", TAG+="uaccess"

# Keep the USB hubs ABOVE the headset, and the headset's own devices, out of runtime autosuspend. Scoped to Pimax:
# only devices with vendor 34a4 match, and the helper walks up from that device to the hubs on its own chain (no
# other hub of the PC is touched).
# Evidence 2026-10-16: after `omarchyvr vr reset-headset` (eSpiCmdSysReset) the headset left USB at 1.1 s and was seen
# again only after ~61-80 s (Windows: 7.8 s). The hubs above it had power/control=auto with autosuspend delay 0, so a
# hub suspends the moment its only child disappears. See analysis/reset-headset-slow-reenum.md.
SUBSYSTEM=="usb", ATTR{idVendor}=="34a4", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="34a4", RUN+="/usr/local/lib/omarchyvr/pimax-hub-power.sh %p"
