From 1da3626699a09a8aa875266e5d939e7f7b88d7f9 Mon Sep 17 00:00:00 2001
From: laughtt <22533943+laughtt@users.noreply.github.com>
Date: Tue, 13 Oct 2026 23:23:12 +0800
Subject: [PATCH] c/client: defer freeing destroyed Vulkan swapchain images
 until the GPU is done

Proton's wineopenxr (D3D11 apps via DXVK) calls xrDestroySwapchain while
DXVK still has GPU work in flight that renders into the swapchain images,
and only releases its D3D11 textures afterwards. client_vk_swapchain_destroy
freed the imported VkDeviceMemory immediately, which unmaps it from the app's
GPU address space; the in-flight work then faults (NVIDIA Xid 31, MMU
FAULT_PDE on GPCCLIENT_PROP), the app's channel is killed, the compositor's
client fence fails ("Fence waiting failed!") and on direct mode the display
engine is left wedged ("Idling display engine timed out").

Reproduced with Dungeons of Eternity (Unity, -openxr) on every graceful quit
and racily on the startup swapchain recreate (dynamic resolution).

Destroyed swapchains now go to a retired list. The next layer_commit (where
the app holds its queue) submits an empty batch with a fence behind them and
frees them once that fence has signalled; session teardown waits for the
fences, or for device idle if no frame was committed since. Opt out with
CLIENT_VK_DEFER_SWAPCHAIN_FREE=0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/xrt/compositor/client/comp_vk_client.c | 183 +++++++++++++++++++++
 src/xrt/compositor/client/comp_vk_client.h |  38 +++++
 2 files changed, 221 insertions(+)

diff --git a/src/xrt/compositor/client/comp_vk_client.c b/src/xrt/compositor/client/comp_vk_client.c
index ad3c7a6..2eed2a8 100644
--- a/src/xrt/compositor/client/comp_vk_client.c
+++ b/src/xrt/compositor/client/comp_vk_client.c
@@ -15,12 +15,15 @@
 #include "util/u_handles.h"
 #include "util/u_trace_marker.h"
 #include "util/u_debug.h"
+#include "util/u_time.h"
 
 #include "comp_vk_client.h"
 
 
 // Prefixed with OXR since the only user right now is the OpenXR state tracker.
 DEBUG_GET_ONCE_LOG_OPTION(vulkan_log, "OXR_VULKAN_LOG", U_LOGGING_INFO)
+// Keep destroyed swapchain images alive until the GPU is done with them (see client_vk_retired).
+DEBUG_GET_ONCE_BOOL_OPTION(defer_swapchain_free, "CLIENT_VK_DEFER_SWAPCHAIN_FREE", true)
 
 /*!
  * Down-cast helper.
@@ -258,6 +261,149 @@ submit_fallback(struct client_vk_compositor *c, xrt_result_t *out_xret)
 }
 
 
+/*
+ *
+ * Deferred freeing of destroyed swapchains.
+ *
+ */
+
+static void
+retired_free(struct client_vk_compositor *c, struct client_vk_retired *r)
+{
+	struct vk_bundle *vk = &c->vk;
+
+	if (r->cmd_count > 0) {
+		vk_cmd_pool_lock(&c->pool);
+		vk->vkFreeCommandBuffers(vk->device, c->pool.pool, r->cmd_count, r->cmds);
+		vk_cmd_pool_unlock(&c->pool);
+	}
+
+	for (uint32_t i = 0; i < r->image_count; i++) {
+		if (r->images[i] != VK_NULL_HANDLE) {
+			vk->vkDestroyImage(vk->device, r->images[i], NULL);
+		}
+		if (r->mems[i] != VK_NULL_HANDLE) {
+			vk->vkFreeMemory(vk->device, r->mems[i], NULL);
+		}
+	}
+
+	if (r->fence != VK_NULL_HANDLE) {
+		vk->vkDestroyFence(vk->device, r->fence, NULL);
+	}
+
+	free(r);
+}
+
+/*!
+ * Called from layer_commit, where the app (and wineopenxr for D3D11 apps) has
+ * all work for the previous frames submitted and holds the queue: put a fence
+ * behind that work for every newly retired swapchain, and free the retired
+ * swapchains whose fence has signalled. Never blocks.
+ */
+static void
+retired_process(struct client_vk_compositor *c)
+{
+	struct vk_bundle *vk = &c->vk;
+	struct client_vk_retired *done = NULL;
+
+	os_mutex_lock(&c->retired.mutex);
+
+	struct client_vk_retired **link = &c->retired.list;
+	while (*link != NULL) {
+		struct client_vk_retired *r = *link;
+
+		if (r->fence == VK_NULL_HANDLE) {
+			VkFenceCreateInfo create_info = {
+			    .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+			};
+			VkResult ret = vk->vkCreateFence(vk->device, &create_info, NULL, &r->fence);
+			if (ret == VK_SUCCESS) {
+				// Empty submit, the fence covers all work submitted to the queue before it.
+				vk_queue_lock(vk->main_queue);
+				ret = vk->vkQueueSubmit(vk->main_queue->queue, 0, NULL, r->fence);
+				vk_queue_unlock(vk->main_queue);
+				if (ret != VK_SUCCESS) {
+					VK_ERROR(vk, "vkQueueSubmit (retire fence): %s", vk_result_string(ret));
+					vk->vkDestroyFence(vk->device, r->fence, NULL);
+					r->fence = VK_NULL_HANDLE;
+				}
+			} else {
+				VK_ERROR(vk, "vkCreateFence (retire fence): %s", vk_result_string(ret));
+				r->fence = VK_NULL_HANDLE;
+			}
+			link = &r->next;
+			continue;
+		}
+
+		if (vk->vkGetFenceStatus(vk->device, r->fence) != VK_NOT_READY) {
+			// Signalled (or device lost, nothing left to wait for).
+			*link = r->next;
+			r->next = done;
+			done = r;
+			continue;
+		}
+
+		link = &r->next;
+	}
+
+	os_mutex_unlock(&c->retired.mutex);
+
+	while (done != NULL) {
+		struct client_vk_retired *r = done;
+		done = r->next;
+		VK_DEBUG(vk, "Freeing %u retired swapchain images", r->image_count);
+		retired_free(c, r);
+	}
+}
+
+/*!
+ * Called when the compositor (session) is destroyed: wait for the retired
+ * swapchains and free them.
+ */
+static void
+retired_flush_all(struct client_vk_compositor *c)
+{
+	struct vk_bundle *vk = &c->vk;
+
+	os_mutex_lock(&c->retired.mutex);
+	struct client_vk_retired *list = c->retired.list;
+	c->retired.list = NULL;
+	os_mutex_unlock(&c->retired.mutex);
+
+	if (list == NULL) {
+		return;
+	}
+
+	bool need_idle = false;
+	for (struct client_vk_retired *r = list; r != NULL; r = r->next) {
+		if (r->fence == VK_NULL_HANDLE) {
+			need_idle = true;
+		}
+	}
+
+	if (need_idle) {
+		/*
+		 * No frame was committed since the swapchain was destroyed, so
+		 * there is no fence behind the app's work. The app does not hold
+		 * its queue for us here, but this only happens at session
+		 * teardown, where waiting for idle is the lesser evil.
+		 */
+		vk_queue_lock(vk->main_queue);
+		vk->vkDeviceWaitIdle(vk->device);
+		vk_queue_unlock(vk->main_queue);
+	}
+
+	while (list != NULL) {
+		struct client_vk_retired *r = list;
+		list = r->next;
+		if (r->fence != VK_NULL_HANDLE) {
+			vk->vkWaitForFences(vk->device, 1, &r->fence, VK_TRUE, 2 * U_TIME_1S_IN_NS);
+		}
+		retired_free(c, r);
+	}
+}
+
+
 /*
  *
  * Swapchain function.
@@ -273,6 +419,34 @@ client_vk_swapchain_destroy(struct xrt_swapchain *xsc)
 	struct client_vk_compositor *c = sc->c;
 	struct vk_bundle *vk = &c->vk;
 
+	if (debug_get_bool_option_defer_swapchain_free()) {
+		struct client_vk_retired *r = U_TYPED_CALLOC(struct client_vk_retired);
+		for (uint32_t i = 0; i < sc->base.base.image_count; i++) {
+			r->images[i] = sc->base.images[i];
+			r->mems[i] = sc->mems[i];
+			if (sc->acquire[i] != VK_NULL_HANDLE) {
+				r->cmds[r->cmd_count++] = sc->acquire[i];
+			}
+			if (sc->release[i] != VK_NULL_HANDLE) {
+				r->cmds[r->cmd_count++] = sc->release[i];
+			}
+		}
+		r->image_count = sc->base.base.image_count;
+
+		os_mutex_lock(&c->retired.mutex);
+		r->next = c->retired.list;
+		c->retired.list = r;
+		os_mutex_unlock(&c->retired.mutex);
+
+		VK_DEBUG(vk, "Deferring free of %u swapchain images until the GPU is done with them", r->image_count);
+
+		// Drop our reference, does NULL checking.
+		xrt_swapchain_native_reference(&sc->xscn, NULL);
+
+		free(sc);
+		return;
+	}
+
 	vk_cmd_pool_lock(&c->pool);
 	for (uint32_t i = 0; i < sc->base.base.image_count; i++) {
 		if (sc->acquire[i] != VK_NULL_HANDLE) {
@@ -408,6 +582,10 @@ client_vk_compositor_destroy(struct xrt_compositor *xc)
 	}
 	xrt_compositor_semaphore_reference(&c->sync.xcsem, NULL);
 
+	// Wait for and free swapchains the app destroyed, needs the pool.
+	retired_flush_all(c);
+	os_mutex_destroy(&c->retired.mutex);
+
 	// Now safe to free the pool.
 	vk_cmd_pool_destroy(vk, &c->pool);
 
@@ -628,6 +806,9 @@ client_vk_compositor_layer_commit(struct xrt_compositor *xc, xrt_graphics_sync_h
 		}
 	}
 
+	// Fence and free swapchains the app destroyed since the last commit.
+	retired_process(c);
+
 	xrt_result_t xret = XRT_SUCCESS;
 	if (submit_handle(c, sync_handle, &xret)) {
 		return xret;
@@ -861,6 +1042,7 @@ client_vk_compositor_create(struct xrt_compositor_native *xcn,
 
 	c->base.info.format_count = xcn->base.info.format_count;
 	c->renderdoc_enabled = renderdoc_enabled;
+	os_mutex_init(&c->retired.mutex);
 
 	// Default to info.
 	enum u_logging_level log_level = debug_get_log_option_vulkan_log();
@@ -938,6 +1120,7 @@ err_pool:
 err_mutex:
 	vk_deinit_mutex(&c->vk);
 err_free:
+	os_mutex_destroy(&c->retired.mutex);
 	free(c);
 
 	return NULL;
diff --git a/src/xrt/compositor/client/comp_vk_client.h b/src/xrt/compositor/client/comp_vk_client.h
index 63f3331..2c822a6 100644
--- a/src/xrt/compositor/client/comp_vk_client.h
+++ b/src/xrt/compositor/client/comp_vk_client.h
@@ -12,6 +12,7 @@
 #pragma once
 
 #include "vk/vk_helpers.h"
+#include "os/os_threading.h"
 #include "vk/vk_cmd_pool.h"
 #include "xrt/xrt_gfx_vk.h"
 
@@ -36,6 +37,31 @@ struct client_vk_compositor;
  * @ingroup comp_client
  * @implements xrt_swapchain_vk
  */
+/*!
+ * Resources of a destroyed swapchain waiting for the GPU to be done with them.
+ *
+ * Apps going through D3D11 translation (Proton wineopenxr + DXVK) call
+ * xrDestroySwapchain while DXVK still has GPU work in flight that renders
+ * into the swapchain images (D3D11 Release semantics defer destruction).
+ * Freeing the imported VkDeviceMemory right away unmaps it from the app's GPU
+ * address space and the in-flight work faults (NVIDIA Xid 31 FAULT_PDE).
+ *
+ * @ingroup comp_client
+ */
+struct client_vk_retired
+{
+	VkImage images[XRT_MAX_SWAPCHAIN_IMAGES];
+	VkDeviceMemory mems[XRT_MAX_SWAPCHAIN_IMAGES];
+	VkCommandBuffer cmds[XRT_MAX_SWAPCHAIN_IMAGES * 2];
+	uint32_t image_count;
+	uint32_t cmd_count;
+
+	//! Signalled when all work submitted before it is done, VK_NULL_HANDLE until submitted.
+	VkFence fence;
+
+	struct client_vk_retired *next;
+};
+
 struct client_vk_swapchain
 {
 	struct xrt_swapchain_vk base;
@@ -80,6 +106,18 @@ struct client_vk_compositor
 
 	struct vk_cmd_pool pool;
 
+	/*!
+	 * Swapchain images, memory and command buffers whose swapchain was
+	 * destroyed by the app but that may still be in use by GPU work the app
+	 * submitted earlier. Freed once a fence submitted after that work has
+	 * signalled, see @ref client_vk_retired.
+	 */
+	struct
+	{
+		struct os_mutex mutex;
+		struct client_vk_retired *list;
+	} retired;
+
 	bool renderdoc_enabled;
 	VkCommandBuffer dcb;
 };
-- 
2.55.0

