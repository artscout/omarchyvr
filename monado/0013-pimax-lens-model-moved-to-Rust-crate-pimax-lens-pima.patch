From 25e4d4814c568fb425a1edb3b5700a8e4751dfbc Mon Sep 17 00:00:00 2001
From: laughtt <22533943+laughtt@users.noreply.github.com>
Date: Wed, 14 Oct 2026 00:36:45 +0800
Subject: [PATCH 13/17] pimax: lens model moved to Rust (crate pimax-lens),
 pimax_lens.c is thin glue

The distortion math, the lens.conf parser, the new per-channel / fit range / black-out / mask options and the
PIMAX_LENS_DEBUG_GRID picture dump live in rust/pimax-lens (pimax-re repo) behind the C ABI of pimax_lens_rs.h.
pimax_lens.c converts types (FOV to radians, UV triplet) and builds the XR_KHR_visibility_mask mesh when a mask is
configured; without a mask the generic FOV mask is used as before.

With an unchanged lens.conf the output is bit-identical to the C model this replaces (rust/pimax-lens-difftest compares
the original source and this glue against the Rust crate on the compositor's 128x128 grid and on random configs).
CMake: links ${PIMAX_RUST_TARGET_DIR}/libpimax_lens.a (cargo build --release -p pimax-lens) next to libpimax_capi.a.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/xrt/drivers/CMakeLists.txt     |  12 ++
 src/xrt/drivers/pimax/pimax_hmd.c  |   8 +
 src/xrt/drivers/pimax/pimax_lens.c | 295 ++++++++---------------------
 src/xrt/drivers/pimax/pimax_lens.h |  44 +++--
 4 files changed, 127 insertions(+), 232 deletions(-)

diff --git a/src/xrt/drivers/CMakeLists.txt b/src/xrt/drivers/CMakeLists.txt
index 6b27c3e..c5a4873 100644
--- a/src/xrt/drivers/CMakeLists.txt
+++ b/src/xrt/drivers/CMakeLists.txt
@@ -134,6 +134,18 @@ if(XRT_BUILD_DRIVER_PIMAX)
 	target_include_directories(drv_pimax PRIVATE ${PIMAX_LIBPIMAX_DIR}/include)
 	target_link_libraries(drv_pimax PRIVATE xrt-interfaces aux_util aux_math Threads::Threads)
 	list(APPEND ENABLED_HEADSET_DRIVERS pimax)
+
+	# The lens model (distortion math, lens.conf parser, visibility mask, debug UV grid) is Rust (rust/pimax-lens);
+	# pimax_lens.c is thin glue over its C ABI. libpimax_lens.a is built next to libpimax_capi.a:
+	#   (cd ~/pimax-re/rust && cargo build --release -p pimax-lens)
+	set(PIMAX_LENS_DIR "/home/user/pimax-re/rust/pimax-lens" CACHE PATH "Path to the pimax-lens crate (include/pimax_lens_rs.h)")
+	if(NOT EXISTS "${PIMAX_RUST_TARGET_DIR}/libpimax_lens.a")
+		message(FATAL_ERROR "pimax driver: ${PIMAX_RUST_TARGET_DIR}/libpimax_lens.a not found. Build it with: "
+			"(cd ~/pimax-re/rust && cargo build --release -p pimax-lens), or set PIMAX_RUST_TARGET_DIR to the directory that has it.")
+	endif()
+	target_include_directories(drv_pimax PRIVATE ${PIMAX_LENS_DIR}/include)
+	# native-static-libs reported by rustc for the staticlibs: -lgcc_s -lutil -lrt -lpthread -lm -ldl -lc
+	target_link_libraries(drv_pimax PRIVATE ${PIMAX_RUST_TARGET_DIR}/libpimax_lens.a ${CMAKE_DL_LIBS} m rt util Threads::Threads)
 endif()
 
