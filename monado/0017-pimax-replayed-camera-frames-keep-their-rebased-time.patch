From 54ab211169cc1c5f01cfb45ac8d060c74251654a Mon Sep 17 00:00:00 2001
From: laughtt <22533943+laughtt@users.noreply.github.com>
Date: Wed, 14 Oct 2026 00:59:04 +0800
Subject: [PATCH 17/17] pimax: replayed camera frames keep their rebased time
 even when the HMD's IMU clock is available

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/xrt/drivers/pimax/pimax_camera.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/xrt/drivers/pimax/pimax_camera.c b/src/xrt/drivers/pimax/pimax_camera.c
index 6746062..14c6166 100644
--- a/src/xrt/drivers/pimax/pimax_camera.c
+++ b/src/xrt/drivers/pimax/pimax_camera.c
@@ -294,7 +294,8 @@ make_attach_offset(struct pimax_camera *pc, struct xrt_pose *out_offset)
 static uint64_t
 frame_time(struct pimax_camera *pc, const pimax_cam_frame_info *fi)
 {
-	if (pc->clock != NULL) {
+	// A replay's device timestamps come from another session: use its rebased monotonic time instead.
+	if ((fi->flags & PIMAX_CAM_FLAG_REPLAY) == 0 && pc->clock != NULL) {
 		struct pimax_camera_clock_ref ref;
 		if (pc->clock(pc->clock_user, &ref) && ref.valid) {
 			pimax_cam_imu_clock_ref r;
