 // Fixed offsets in the head-yaw frame (x right, y up, -z forward).
 #define OFF_SIDE 0.20f
@@ -65,6 +76,7 @@ enum
 	I_STICK,
 	I_GRIP_POSE,
 	I_AIM_POSE,
