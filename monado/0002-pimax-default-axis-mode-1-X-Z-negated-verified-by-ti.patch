From 1a20fdced359b8bb4592fd5a763c9b9503058176 Mon Sep 17 00:00:00 2001
From: laughtt <22533943+laughtt@users.noreply.github.com>
Date: Tue, 13 Oct 2026 20:47:28 +0800
Subject: [PATCH 2/7] pimax: default axis mode 1 (X/Z negated), verified by
 tilt test

---
 src/xrt/drivers/pimax/pimax_hmd.c       | 2 +-
 src/xrt/drivers/pimax/pimax_interface.h | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/xrt/drivers/pimax/pimax_hmd.c b/src/xrt/drivers/pimax/pimax_hmd.c
index 7ea82e2..1d6c8e1 100644
--- a/src/xrt/drivers/pimax/pimax_hmd.c
+++ b/src/xrt/drivers/pimax/pimax_hmd.c
@@ -40,7 +40,7 @@ DEBUG_GET_ONCE_LOG_OPTION(pimax_log, "PIMAX_LOG", U_LOGGING_INFO)
 //! TODO: the panels are mounted rotated by 90 deg (direction unknown). 0, 90, 180 or 270.
 DEBUG_GET_ONCE_NUM_OPTION(pimax_panel_rotation, "PIMAX_PANEL_ROTATION", 0)
 //! 0: sensor axes == OpenXR axes (+X right, +Y up, -Z fwd). 1: 180 deg about Y (X and Z flipped).
-DEBUG_GET_ONCE_NUM_OPTION(pimax_axis_mode, "PIMAX_AXIS_MODE", 0)
+DEBUG_GET_ONCE_NUM_OPTION(pimax_axis_mode, "PIMAX_AXIS_MODE", 1)
 DEBUG_GET_ONCE_NUM_OPTION(pimax_bias_ms, "PIMAX_BIAS_MS", 2000)
 
 #define PIMAX_EYE_W 3552
diff --git a/src/xrt/drivers/pimax/pimax_interface.h b/src/xrt/drivers/pimax/pimax_interface.h
index f4e97fb..c1a4fa5 100644
--- a/src/xrt/drivers/pimax/pimax_interface.h
+++ b/src/xrt/drivers/pimax/pimax_interface.h
@@ -21,7 +21,7 @@ extern "C" {
  * @brief 3DoF driver for the Pimax Dream Air on top of libpimax (hidraw wake/keepalive + 1 kHz IMU).
  *
  * Env vars: PIMAX_LOG, PIMAX_PANEL_ROTATION (0/90/180/270, default 0, TODO),
- * PIMAX_AXIS_MODE (0 = identity, 1 = 180 deg about Y), PIMAX_BIAS_SECONDS (default 2).
+ * PIMAX_AXIS_MODE (0 = identity, 1 = 180 deg about Y, default: verified by nose-down tilt test 2026-10-13), PIMAX_BIAS_SECONDS (default 2).
  */
 
 #define PIMAX_DRV_VID 0x34a4
-- 
2.55.0

