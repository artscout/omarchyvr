# pacman hook TEMPLATE: re-apply the Pimax 2Heads1OR viewport patch to the nvidia-open-dkms source after every install
# or upgrade of the package, BEFORE dkms builds the module.
#
# Ordering: PostTransaction hooks run sorted by file name. Arch's dkms package builds in 70-dkms-install.hook and the
# initramfs is regenerated by 90-mkinitcpio-install.hook, so this one has to sort before "70": install it as
# 65-nvidia-pimax-patch.hook.
#
# Install (needs sudo; NOT done automatically) - one command, installs the script, all three patches and both hooks:
#   sudo env L="$HOME/pimax-re/linux" bash -c 'install -Dm755 $L/nvidia-patch-reapply.sh /usr/local/lib/omarchyvr/nvidia-patch-reapply.sh && for p in nvidia-2h1or-viewport nvidia-2h1or-flip-fix nvidia-evo-makeroom-bounded-wait; do install -Dm644 $L/$p.patch /usr/local/lib/omarchyvr/$p.patch; done && install -Dm644 $L/nvidia-pimax-patch.hook /etc/pacman.d/hooks/65-nvidia-pimax-patch.hook && install -Dm644 $L/nvidia-pimax-verify.hook /etc/pacman.d/hooks/75-nvidia-pimax-verify.hook'
# (The files are copied to a root-owned
# directory because pacman runs the hook as root; do not point the hook at files in a home directory.)
# The patches are applied in order: viewport, flip-fix, evo-makeroom-bounded-wait. 75-nvidia-pimax-verify.hook runs
# after dkms built the module and checks modinfo for merged_head_sync.
# Remove it once NVIDIA merges the fixes into the driver you run:
#   sudo rm /etc/pacman.d/hooks/65-nvidia-pimax-patch.hook /etc/pacman.d/hooks/75-nvidia-pimax-verify.hook; sudo rm -r /usr/local/lib/omarchyvr

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = nvidia-open-dkms

[Action]
Description = Re-applying the Pimax NVIDIA patches (viewport, flip-fix, makeroom) to the nvidia-open-dkms source...
When = PostTransaction
Exec = /usr/local/lib/omarchyvr/nvidia-patch-reapply.sh --hook
Depends = patch
